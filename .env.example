# 개발 서버(vite) 프록시 목적지.
# 백엔드가 MSA 로 나뉘어 서비스별로 주소가 다르다.
# 값을 안 주면 vite.config.js 의 기본값(아래와 동일)을 쓴다.
VITE_USER_ORIGIN=http://localhost:8081
VITE_POST_ORIGIN=http://localhost:8082
VITE_CHAT_ORIGIN=http://localhost:8083

# riot(:8084) 은 클러스터 내부 전용이라 브라우저가 직접 부르지 않는다.
# 라이엇 연동은 /api/users/riot/* 로 user 를 거쳐 간다.
